        "parameters" : [ {
          "name" : "type",
          "in" : "query",
          "description" : "Type de document (CIN, PERMIS)",
          "required" : true,
          "schema" : {
            "type" : "string",
            "enum" : [ "PERMIS", "CIN", "PASSEPORT" ]
          }
        } ],
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "required" : [ "file" ],
                "type" : "object",
                "properties" : {
                  "file" : {
                    "type" : "string",
                    "description" : "Fichier du document (PDF, PNG, JPG - max 5 Mo)",
                    "format" : "binary"
                  }
                }
              }
            }
          }
        },
        "responses" : {
          "401" : {
            "description" : "Non authentifié"
          },
          "201" : {
            "description" : "Document téléversé avec succès",
            "content" : {
