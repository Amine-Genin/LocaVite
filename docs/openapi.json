  "components" : {
    "schemas" : {
      "VehicleRequest" : {
        "required" : [ "annee", "carburant", "categorie", "description", "marque", "matricule", "modele", "places", "prixJour", "prixVente", "transmission", "ville" ],
        "type" : "object",
        "properties" : {
          "marque" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "modele" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "annee" : {
            "minimum" : 1990,
            "type" : "integer",
            "format" : "int32"
          },
          "categorie" : {
            "type" : "string",
            "enum" : [ "CITADINE", "BERLINE", "SUV", "LUXE", "UTILITAIRE" ]
          },
          "ville" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "prixJour" : {
            "minimum" : 0.0,
            "exclusiveMinimum" : true,
            "type" : "number"
          },
          "prixVente" : {
            "minimum" : 0.0,
            "exclusiveMinimum" : true,
            "type" : "number"
          },
          "carburant" : {
            "type" : "string",
            "enum" : [ "ESSENCE", "DIESEL", "HYBRIDE", "ELECTRIQUE" ]
          },
          "transmission" : {
            "type" : "string",
            "enum" : [ "MANUELLE", "AUTOMATIQUE" ]
          },
          "places" : {
            "type" : "integer",
            "format" : "int32"
          },
          "description" : {
            "type" : "string"
          },
          "matricule" : {
            "maxLength" : 30,
            "minLength" : 0,
            "type" : "string"
          },
          "statut" : {
            "type" : "string",
            "enum" : [ "DRAFT", "PUBLISHED", "RENTED", "SOLD", "ARCHIVED" ]
          }
        }
      },
      "VehicleResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "marque" : {
            "type" : "string"
          },
          "modele" : {
            "type" : "string"
          },
          "annee" : {
            "type" : "integer",
            "format" : "int32"
          },
          "categorie" : {
            "type" : "string",
            "enum" : [ "CITADINE", "BERLINE", "SUV", "LUXE", "UTILITAIRE" ]
          },
          "ville" : {
            "type" : "string"
          },
          "prixJour" : {
            "type" : "number"
          },
          "prixVente" : {
            "type" : "number"
          },
          "carburant" : {
            "type" : "string",
            "enum" : [ "ESSENCE", "DIESEL", "HYBRIDE", "ELECTRIQUE" ]
          },
          "transmission" : {
            "type" : "string",
            "enum" : [ "MANUELLE", "AUTOMATIQUE" ]
          },
          "places" : {
            "type" : "integer",
            "format" : "int32"
          },
          "description" : {
            "type" : "string"
          },
          "matricule" : {
            "type" : "string"
          },
          "statut" : {
            "type" : "string",
            "enum" : [ "DRAFT", "PUBLISHED", "RENTED", "SOLD", "ARCHIVED" ]
          },
          "agenceId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
