{
    "name": "locavite-frontend",
    "version": "0.1.0",
    "private": true,
    "description": "Application web Angular 18 de la plateforme LocaVite",
    "scripts": {
        "start": "ng serve",
        "build": "ng build",
        "test": "node -e \"if (!process.env.CHROME_BIN) { const edge = 'C:\\\\Program Files (x86)\\\\Microsoft\\\\Edge\\\\Application\\\\msedge.exe'; if (require('fs').existsSync(edge)) process.env.CHROME_BIN = edge; } const res = require('child_process').spawnSync('ng test --watch=false', { stdio: 'inherit', shell: true, env: process.env }); process.exit(res.status ?? 0);\"",
        "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
        "test:coverage": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
        "test:e2e": "node cypress/scripts/run-e2e-ci.cjs",
        "e2e:ci": "node cypress/scripts/run-e2e-ci.cjs",
        "lint": "ng lint",
        "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\""
    },
    "dependencies": {
        "@angular/animations": "^21.2.26",
        "@angular/cdk": "^22.2.6",
        "@angular/common": "^22.2.4",
        "@angular/compiler": "^22.2.4",
        "@angular/core": "^22.2.4",
        "@angular/forms": "^22.2.4",
        "@angular/material": "^22.2.6",
        "@angular/platform-browser": "^22.2.4",
        "@angular/platform-browser-dynamic": "^21.2.26",
        "@angular/router": "^22.2.4",
        "@angular/service-worker": "^22.2.4",
        "@ngx-translate/core": "16.0.4",
        "@ngx-translate/http-loader": "16.0.1",
        "chart.js": "4.4.4",
        "rxjs": "7.8.1",
        "tslib": "2.7.0",
        "zone.js": "0.14.10"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^21.2.29",
        "@angular/cli": "^22.2.5",
        "@angular/compiler-cli": "^22.2.4",
        "@types/jasmine": "5.1.4",
        "angular-eslint": "^22.6.0",
        "cypress": "^16.2.1",
        "eslint": "^4.0.0",
        "eslint-config-prettier": "^6.15.0",
        "jasmine-core": "5.4.0",
        "karma": "6.4.4",
        "karma-chrome-launcher": "3.2.0",
        "karma-coverage": "^0.2.2",
        "karma-jasmine": "^0.3.8",
        "karma-jasmine-html-reporter": "2.1.0",
        "prettier": "^3.9.10",
        "typescript": "5.5.4",
        "typescript-eslint": "^8.14.0"
    }
}
