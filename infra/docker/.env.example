# ==============================================================================
# Environnement de développement local LocaVite (Docker Compose)
# Copier ce fichier vers infra/docker/.env pour surcharger les valeurs locales :
#   cp infra/docker/.env.example infra/docker/.env
# ==============================================================================

# PostgreSQL 16
POSTGRES_DB=locavite
POSTGRES_USER=locavite
POSTGRES_PASSWORD=locavite_dev_password
POSTGRES_PORT=5432

# Redis 7
REDIS_PORT=6379

# MinIO (Stockage objet S3)
MINIO_IMAGE=2821568820/minio:RELEASE.2024-10-13T13-34-11Z
MINIO_ROOT_USER=locavite
MINIO_ROOT_PASSWORD=locavite_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# MailHog (Serveur SMTP de test)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
